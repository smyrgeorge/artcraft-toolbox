<?xml version="1.0" encoding="utf-8"?>
<!--
  ArtCraft Toolbox MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util
  extensions: `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`).
  Built by package.ps1 (PhotoCraft's artcraft-toolbox.wxs, ported, without file associations):

    wix build artcraft-toolbox.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc artcraft-toolbox.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\ArtCraft Toolbox by default, remembered for upgrades), Ready, a progress page,
  and a Finish page with a ticked "Launch ArtCraft Toolbox" box. Installs a Start Menu shortcut
  and the CLI, and registers App Paths (Win+R "artcraft-toolbox"). `msiexec /qn` still installs
  silently. A per-machine install can't update itself (Program Files isn't writable without
  elevation): the toolbox says so and points at the installer (docs/architecture.md § 7).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="ArtCraft Toolbox"
      Manufacturer="ArtCraft Toolbox contributors"
      Version="$(var.Version)"
      UpgradeCode="7C3F0B5E-9D2A-4F6B-8E1C-2A5D7B9F4E61"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="ArtCraft Toolbox: install, update and launch the Crafting Apps" Manufacturer="ArtCraft Toolbox contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of ArtCraft Toolbox is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="ArtcraftToolboxIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ArtcraftToolboxIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/smyrgeorge/artcraft-toolbox" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/smyrgeorge/artcraft-toolbox/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/smyrgeorge/artcraft-toolbox/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ArtCraft Toolbox" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by ArtcraftToolboxApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\ArtCraft Toolbox" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="ArtCraft Toolbox" Level="1">
      <ComponentGroupRef Id="ArtcraftToolboxFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchArtcraftToolbox"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through artcraft-toolbox.en-us.wxl. -->
    <Property Id="ArtcraftToolboxVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="ArtCraft Toolbox $(var.DisplayVersion) is installed. It lives in the system tray; start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch ArtCraft Toolbox" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#ArtcraftToolboxExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchArtcraftToolbox" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="ArtcraftToolboxFiles" Directory="INSTALLFOLDER">
      <Component Id="ArtcraftToolboxApp" Guid="3B8E6D1F-5C72-4A9E-B0D4-6F1E8C2A7D93">
        <File Id="ArtcraftToolboxExe" Source="$(var.BinDir)\artcraft-toolbox.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="ArtCraft Toolbox"
              Description="Install, update and launch the Crafting Apps" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="ArtcraftToolboxIcon.exe" IconIndex="0" />
        </File>
        <!-- The Run dialog (Win+R "artcraft-toolbox") and "Open with" naming. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\artcraft-toolbox.exe" Name="FriendlyAppName" Value="ArtCraft Toolbox" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\artcraft-toolbox.exe" Value="[#ArtcraftToolboxExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ArtCraft Toolbox" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="ArtcraftToolboxCli">
        <File Id="ArtcraftToolboxCliExe" Source="$(var.BinDir)\artcraft-toolbox-cli.exe" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\artcraft-toolbox-cli.exe" Value="[#ArtcraftToolboxCliExe]" Type="string" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
