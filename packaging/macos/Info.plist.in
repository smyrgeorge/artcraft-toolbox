<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>ArtCraft Toolbox</string>
  <key>CFBundleName</key>
  <string>ArtCraft Toolbox</string>
  <key>CFBundleExecutable</key>
  <string>ArtCraft Toolbox</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.toolbox</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>ArtCraftToolboxVersion</key>
  <string>@VERSION@</string>
  <key>ArtCraftToolboxBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>ArtCraft Toolbox</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.utilities</string>
  <!-- A menu-bar app: no Dock icon and no app menu (the app sets the accessory activation policy
       too, apps/artcraft-toolbox/src/main.rs; this keeps the Dock icon from bouncing at launch). -->
  <key>LSUIElement</key>
  <true/>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the ArtCraft Toolbox authors. MIT OR Apache-2.0.</string>
</dict>
</plist>
